{
  "name": "viu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "protocol",
    "middleman",
    "app"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --force && tsc -p tsconfig.tools.json && npm run typecheck --workspace @viu/app",
    "lint": "eslint .",
    "test": "vitest run && npm test --workspace @viu/app",
    "start": "npm run build && npm run start --workspace @viu/middleman",
    "serve": "npm run build && npm run serve --workspace @viu/middleman",
    "clean": "tsc -b --clean"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
